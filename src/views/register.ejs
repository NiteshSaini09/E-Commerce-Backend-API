<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Register</title>
    <style>
        *{
            margin: 0;
            padding: 0;
            font-family: monospace;
            box-sizing: border-box;
        }
        body{
            display: flex;
            align-items: center;
            justify-content: center;
        }
        form{
            
            height: 40vh;
            margin-top: 30vh;
            width: 20vw;
            /* padding: 50px;
            margin: 30px; */
            /* border: 1px solid; */
            gap: 20px;
            align-items: center;
            justify-content: center;
            display: flex;
            flex-direction: column;
        }
        input{
            width: 80%;
            height: 40px;
            /* border: 1px solid; */
            border: none;
            padding-left: 20px;
            border-radius: 5px;
            box-shadow: 1px 1px 5px 1px rgb(0, 0, 0);
        }
        input:focus{
            border: none;
            outline: none;
        }
        button{
            width: 30%;
            height: 40px;
            border: none;
            border-radius: 5px;
            background-color: maroon;
            color: white;
            font-weight: bold;
            font-family:cursive;
            box-shadow: 1px 1px 20px 1px maroon;
        }
    </style>
</head>
<body>
    <form action="/api/v1/user/register" method="post" autocomplete="off">
        <input type="text" name="name" placeholder="Enter Your Name">
        <input type="text" name="email" placeholder="Enter your eMail">
        <input type="text" name="role" placeholder="Role: User or Admin">
        <input type="password" name="password" placeholder="password">
        <button type="submit">Register</button>
    </form>
</body>
</html>